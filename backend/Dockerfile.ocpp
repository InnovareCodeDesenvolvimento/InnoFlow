# Idêntico a `Dockerfile`, só muda o CMD final — existe porque o EasyPanel
# não deixa sobrescrever o comando de start quando o método de build é
# "Dockerfile" (só tem esse campo pra Nixpacks/Buildpacks). Mesmo truque do
# projeto irmão ParquedasFeiras (`Dockerfile` + `Dockerfile.web`). Editou um
# dos três Dockerfiles do backend? Copie a mudança pros outros dois — CI não
# pega divergência entre eles.
#
# Comentários completos (por que openssl nos estágios, por que `tsx`/`prisma` ficam no runner, por que
# `USER node`, por que `node_modules/.bin/prisma` e não `npx`): ver `Dockerfile`. N-3, 05/10/2026.
FROM node:22-alpine AS builder
RUN apk add --no-cache openssl
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npx prisma generate
# Teto do heap do Node so neste passo (nao afeta `npm ci`/runtime). Medido: `tsc` do backend PASSA com 512 MB e ABORTA com 384
# ("JavaScript heap out of memory", exit 134); o piso (~450 MB) sobe com o codigo e o padrao do V8 em container pequeno pode ficar
# perto dele. 1536 MB = ~3x o piso; nao reserva memoria. Mesma regra do frontend/Dockerfile. Copie a mudanca aos 3 Dockerfiles.
RUN NODE_OPTIONS=--max-old-space-size=1536 npm run build

FROM node:22-alpine AS prod-deps
RUN apk add --no-cache openssl
WORKDIR /app
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm ci --omit=dev
RUN npx prisma generate

FROM node:22-alpine AS runner
RUN apk add --no-cache openssl
# Cliente do PostgreSQL para o backup — ver o comentário completo no `Dockerfile`. Idêntico nos 3 arquivos.
RUN (apk add --no-cache postgresql18-client || apk add --no-cache postgresql17-client) \
  && pg_dump --version && pg_restore --version && psql --version
WORKDIR /app
ENV NODE_ENV=production
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/src ./src
COPY --from=builder /app/scripts ./scripts

USER node

# O backup roda como `node`: confirma que o cliente executa sem root e que há onde gravar o dump temporário (/tmp).
RUN pg_dump --version && pg_restore --version && psql --version && tmp="$(mktemp -d)" && test -w "$tmp" && rm -rf "$tmp"

# `prisma migrate deploy &&` — ver explicação completa no `Dockerfile`
# principal (achado real de produção, 17/09/2026). Seguro rodar concorrente
# com os outros 2 serviços (lock consultivo do Prisma no Postgres).
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && node dist/entrypoints/ocpp.js"]
