# Idêntico a `Dockerfile`, só muda o CMD final — existe porque o EasyPanel
# não deixa sobrescrever o comando de start quando o método de build é
# "Dockerfile" (só tem esse campo pra Nixpacks/Buildpacks). Mesmo truque do
# projeto irmão ParquedasFeiras (`Dockerfile` + `Dockerfile.web`). Editou um
# dos três Dockerfiles do backend? Copie a mudança pros outros dois — CI não
# pega divergência entre eles.
FROM node:20-alpine AS builder
RUN apk add --no-cache openssl
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npx prisma generate
RUN npm run build

FROM node:20-alpine AS runner
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/src ./src

CMD ["node", "dist/entrypoints/ocpp.js"]
