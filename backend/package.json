{
  "name": "innoelektron-backend",
  "version": "0.1.0",
  "description": "Backend do InnoElektron — 3 entrypoints (api, ocpp, worker) num único monólito modular",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:ocpp": "tsx watch src/entrypoints/ocpp.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "build": "tsc",
    "start:api": "node dist/entrypoints/api.js",
    "start:ocpp": "node dist/entrypoints/ocpp.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:test-partitioning": "tsx prisma/scripts/test-partitioning.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "ocpp-rpc": "^2.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^5.20.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.8"
  }
}
