# Copie para .env e ajuste. Nunca commite o .env de verdade (já está no
# .gitignore da raiz).

NODE_ENV=development
LOG_LEVEL=info

# Postgres (bate com o docker-compose.yml da raiz)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/innoelektron

# Redis (pub/sub de comandos API -> carregador, e fila BullMQ do worker)
REDIS_URL=redis://localhost:6379

# entrypoints/api.ts — API REST/SSE
PORT=3000

# entrypoints/ocpp.ts — gateway OCPP 1.6-J (WebSocket)
OCPP_PORT=9000

# Auth da API (JWT HS256). GERE UM SEGREDO FORTE em produção — isto aqui é só
# para dev local, nunca reutilize. Em NODE_ENV=production o boot FALHA com menos de
# 32 caracteres (gere com: openssl rand -base64 48); fora de produção só avisa.
JWT_SECRET=dev-only-troque-isto-por-um-segredo-forte-de-verdade
JWT_EXPIRES_IN=12h

# Opcional — identidade deste processo no barramento de comandos OCPP e no
# lock anti-split-brain. Se vazio, cada processo gera um UUID próprio no boot.
OCPP_NODE_ID=

# ---------------------------------------------------------------------------
# Pagamentos (Cielo) — F5. TODAS opcionais: sem elas o servidor sobe normalmente.
# ---------------------------------------------------------------------------
# Em PRODUÇÃO, sem CIELO_MERCHANT_ID e CIELO_MERCHANT_KEY o Pix e o cartão ficam
# BLOQUEADOS (503) — nunca fingem cobrar. Em dev/CI usam um simulador (FakeAdapter).
# CIELO_MERCHANT_ID=
# CIELO_MERCHANT_KEY=
# true = sandbox, false = produção (vazio = sandbox). Valores aceitos: true/false/1/0/yes/no/on/off.
# CIELO_SANDBOX=true
# Chave de 32 bytes que cifra o token do cartão salvo. Gere com: openssl rand -base64 32
# PAYMENT_SECRETS_KEY=
# Rotação de chave: a chave ANTERIOR (só decifra; o que é gravado usa sempre a atual). Remova depois de `npm run payments:recifrar-segredos -- --apply`.
# Runbook em docs/DEPLOY-EASYPANEL.md.
# PAYMENT_SECRETS_KEY_PREVIOUS=
# Sandbox em servidor de PRODUÇÃO (NODE_ENV=production com o gateway em sandbox): Pix e cartão só funcionam para os motoristas cujo e-mail está
# nesta lista (separada por vírgula, sem distinguir maiúsculas). Vazia/ausente = NINGUÉM (falha segura). Existe porque os cartões de teste da
# Cielo são públicos e o cadastro é aberto: sandbox numa instância pública seria cobrança grátis. Crie a conta do testador ANTES de listar o e-mail.
# PAYMENT_SANDBOX_TESTER_EMAILS=dono@empresa.com.br,teste@empresa.com.br
# Webhook da Cielo (path e segredo do header x-innoelektron-webhook-secret). O boot aceita 8+ caracteres, mas o uso AVISA no log abaixo
# de 32 (o segredo do header é a única autenticação do webhook): use `openssl rand -hex 24`. O PUT da tela do gateway EXIGE 32+.
# CIELO_WEBHOOK_PATH_TOKEN=
# CIELO_WEBHOOK_HEADER_SECRET=
# Rede de segurança da CAPTURA de cartão (F5.7): um intent CAPTURE_PENDING parado há mais de N minutos é reenfileirado pelo varredor
# (default 5); no máximo CARD_CAPTURE_MAX_SWEEP_RETRIES reenfileiramentos por intent (default 100), depois só alerta no log.
# CARD_CAPTURE_RETRY_AFTER_MINUTES=5
# CARD_CAPTURE_MAX_SWEEP_RETRIES=100
# ---------------------------------------------------------------------------
# Sessão travada / watchdog (F5.9) — TODAS opcionais, os defaults abaixo são os recomendados. O watchdog roda no worker e decide SÓ pelo relógio do
# servidor. Detalhe: .claude/agent-memory/nova/decisoes-f59-sessao-travada.md
# ---------------------------------------------------------------------------
# KILL-SWITCH do watchdog de sessões travadas (default FALSE: nasce DESLIGADO). Ordem de deploy: migration -> API/gateway -> ligar esta chave e subir o worker.
# Desligar = remove o agendamento e o ciclo para de agir; handlers e rotas continuam. true/1/yes/on e false/0/no/off.
# SESSION_WATCHDOG_ENABLED=false
# SESSION_WATCHDOG_INTERVAL_MS=60000
# SESSION_WATCHDOG_BATCH_SIZE=100
# Carregador offline há >= N min E sem atividade da sessão há >= M min => sessão vai para "em confirmação" (STOP_UNCONFIRMED, sem cobrar nada ainda).
# SESSION_CHARGER_OFFLINE_MINUTES=10
# SESSION_INACTIVITY_MINUTES=15
# Conector online que voltou a Available/Unavailable depois de a sessão abrir, há >= N min => "em confirmação".
# SESSION_CONNECTOR_IDLE_MINUTES=5
# Depois de um RemoteStop, espera N min pelo StopTransaction; reenvia até SESSION_STOP_MAX_ATTEMPTS vezes (contando a 1ª), depois "em confirmação" + alerta.
# SESSION_STOP_CONFIRM_MINUTES=5
# SESSION_STOP_MAX_ATTEMPTS=3
# Carregador online, conector Charging e sem MeterValues: pede um MeterValues (TriggerMessage) no máximo 1x a cada N min. NUNCA fecha a sessão por isso.
# SESSION_METER_TRIGGER_COOLDOWN_MINUTES=15
# Idade máxima de uma sessão aberta (pede RemoteStop e, sem resposta, marca "em confirmação").
# SESSION_MAX_OPEN_HOURS=24
# Em "em confirmação": quanto esperar o carregador (que pode mandar o StopTransaction enfileirado) antes de o servidor encerrar — online agora / offline agora.
# SESSION_UNCONFIRMED_GRACE_ONLINE_MINUTES=10
# SESSION_UNCONFIRMED_GRACE_OFFLINE_MINUTES=120
# Teto do hold da pré-autorização do cartão (horas): passou disso, o servidor encerra mesmo dentro da janela e alerta. Mantenha >= SESSION_MAX_OPEN_HOURS.
# CARD_SESSION_MAX_HOLD_HOURS=48
# DECISÃO DO DONO (D2, ainda não confirmada): sessão encerrada pelo servidor SEM nenhuma leitura de medidor.
#   NO_CHARGE (padrão) = não cobra, alerta e fica para revisão manual;  MIN_FEE = cobra a taxa fixa + o mínimo da tarifa (comportamento antigo).
# SESSION_NO_READING_POLICY=NO_CHARGE
# DECISÃO DO DONO (D7, ainda não confirmada): o motorista pode iniciar outra recarga enquanto a anterior está "em confirmação"? true = sim (desconta o saldo comprometido).
# SESSION_ALLOW_START_WHILE_UNCONFIRMED=true
# Cadastro de cartão (Silent Order Post) — a confirmar com a Cielo.
# CIELO_SOP_SCRIPT_URL=
# CIELO_SOP_CLIENT_ID=
# CIELO_SOP_CLIENT_SECRET=
# CIELO_SOP_OAUTH_TOKEN_URL=
# NUNCA ligue em produção real: o simulador aprova QUALQUER cartão e não cobra nada.
# Só para demonstrar o fluxo antes de ter conta Cielo.
# PAYMENT_ALLOW_FAKE_ADAPTER=false
