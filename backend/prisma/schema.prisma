// ============================================================
// InnoElektron — Prisma Schema
// ============================================================
// Fase 1 (modelagem de dados, Cronos) — a partir do desenho de alto nível da
// Nova (§4 do handoff de arquitetura, ver PROGRESSO.md e
// .claude/agent-memory/nova/) e das decisões do dono registradas ali.
//
// Convenções deste schema (documentadas para quem for ler/alterar):
//
// 1. MULTI-TENANT REAL: `Operator` é entidade de primeira classe. A FK
//    "de origem" mora em `Site` (Site.operatorId, canônica) e desce por
//    `ChargePoint.siteId`. Nas tabelas QUENTES de leitura/escrita do caminho
//    OCPP e do dinheiro — ChargePoint, Connector, ChargingSession,
//    MeterSample, OcppMessage, PaymentIntent — `operatorId` é DESNORMALIZADO
//    (coluna própria + FK real para Operator) para o Vega filtrar por
//    operador em uma coluna só, sem join. A consistência dessa coluna
//    denormalizada NÃO depende do código da aplicação: é mantida por
//    triggers `BEFORE INSERT/UPDATE` (ver migration.sql) que copiam
//    operatorId do pai (Site/ChargePoint/Connector/ChargingSession) —
//    e sobrescrevem qualquer valor divergente que a aplicação tente gravar.
// 2. DINHEIRO: valores fechados (custos, taxas, saldo) em centavos inteiros
//    (`Int`). Preço UNITÁRIO (por kWh, por minuto) em `Decimal(12,4)`,
//    guardado em reais (não centavos) para manter precisão sub-centavo na
//    multiplicação — nunca `Float`.
// 3. Vários `@@index`/`@@unique` e TODAS as CHECK constraints, o gatilho de
//    append-only da carteira e o particionamento
//    mensal de MeterSample/OcppMessage vivem no `migration.sql` hand-escrito
//    (ver prisma/migrations/) — Prisma não tem DSL para isso no schema.

generator client {
  provider      = "prisma-client-js"
  // "native" cobre dev local (Windows/macOS/Linux glibc). O runtime de
  // produção (node:20-alpine no EasyPanel) precisa do target musl EXPLÍCITO
  // com OpenSSL 3.0 — Alpine 3.18+ não tem mais libssl.so.1.1, que é o que
  // o target genérico "linux-musl" (sem sufixo) assume. Sem isto o container
  // sobe e quebra só na primeira query, com
  // "Error loading shared library libssl.so.1.1: No such file or directory"
  // (erro real visto em produção, 16/09/2026).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Role {
  ADMIN // plataforma (o dono) — atravessa todos os operadores
  OPERATOR // staff de um Operator — escopado a operatorId
  DRIVER // motorista — identidade única na rede, roda por qualquer operador (B2C)
}

enum ConnectorType {
  AC_TYPE2
  DC_CCS2 // instalação real de lançamento — caso de teste/seed principal
  DC_CHADEMO
}

enum ConnectorStatus {
  AVAILABLE
  PREPARING
  CHARGING
  SUSPENDED_EVSE
  SUSPENDED_EV
  FINISHING
  RESERVED
  UNAVAILABLE
  FAULTED
}

enum ChargingSessionStatus {
  STARTED
  CHARGING
  FINISHING // carro parou de puxar energia, ainda plugado — janela de ociosidade aberta
  STOPPED
  FAULTED
  // F5.9 (2026-10-03): o SERVIDOR tentou parar/fechar a sessão (stop rejeitado,
  // sem confirmação, carregador sumido/reiniciado, conector ocioso, duração
  // máxima) mas ainda não há prova do carregador. Estado PROVISÓRIO: nada é
  // debitado nem capturado aqui; o watchdog encerra (STOPPED) depois da janela
  // de confirmação com a melhor prova disponível. Fora do índice único
  // ux_charging_session_active_per_connector (ver migration 20261003120100).
  STOP_UNCONFIRMED
}

// Quem fechou a sessão (F5.9): o próprio carregador (StopTransaction real) ou
// o servidor (watchdog/reconciliação, sem StopTransaction). NULL = sessão
// aberta ou STOPPED legada anterior à F5.9 (não inventamos valor).
enum SessionClosureSource {
  CHARGER
  SERVER
}

// De onde veio o meterStopWh do fechamento (F5.9), do mais para o menos
// confiável: StopTransaction do carregador > última amostra
// Energy.Active.Import.Register > nenhuma leitura (energia 0).
enum MeterStopSource {
  STOP_TRANSACTION
  LAST_METER_SAMPLE
  NO_READING
}

// Por que a sessão entrou em STOP_UNCONFIRMED (F5.9).
enum StopUnconfirmedReason {
  STOP_REJECTED // RemoteStopTransaction recusado pelo carregador
  STOP_NOT_CONFIRMED // stop enviado, sem StopTransaction dentro da janela
  CHARGER_UNREACHABLE // carregador offline além da janela
  CHARGER_REBOOTED // BootNotification com a sessão ainda aberta
  CONNECTOR_IDLE // conector Available/Faulted enquanto a sessão seguia aberta
  MAX_DURATION // estourou a duração máxima configurada
}

// Quem pediu a parada (F5.9) — gravado em stopRequestedBy.
enum SessionStopRequester {
  DRIVER
  ADMIN
  GUARD // guarda de saldo/teto do cartão
  WATCHDOG
}

// Como esta sessão é cobrada (F5.4, 2026-09-30). Nome segue a convenção
// Model+Conceito já usada neste schema (PaymentIntentStatus, PaymentMethodType).
// WALLET é o default histórico (débito direto na carteira no StopTransaction,
// sem PaymentIntent — ver walletLedger.ts); CARD é o caminho novo da F5
// (pré-autorização no início via PaymentIntent.authTokenId, captura parcial
// no fim via captureAmountCents). Guardado na sessão, não derivado do
// PaymentIntent, porque o modo é decidido ANTES de existir qualquer intent
// (na escolha do motorista em /sessions/start) e precisa sobreviver mesmo
// que a pré-autorização falhe antes do RemoteStart.
enum ChargingSessionPaymentMode {
  WALLET
  CARD
}

enum StopReason {
  LOCAL
  REMOTE
  EV_DISCONNECTED
  HARD_RESET
  SOFT_RESET
  POWER_LOSS
  EMERGENCY_STOP
  DEAUTHORIZED
  UNLOCK_COMMAND
  OTHER
}

enum AuthTokenType {
  RFID
  VIRTUAL // gerado por sessão iniciada pelo app, amarrado a um User
  APP
}

enum AuthTokenStatus {
  ACCEPTED
  BLOCKED
  EXPIRED
  INVALID
}

enum TariffModel {
  PER_KWH
  PER_MINUTE
  PER_SESSION
  HYBRID
}

enum TariffScope {
  CONNECTOR
  CHARGE_POINT
  SITE
  OPERATOR
}

enum PaymentMethodType {
  CREDIT_CARD
}

enum PaymentProvider {
  CIELO_CARD
  CIELO_PIX
  WALLET
}

enum PaymentIntentPurpose {
  SESSION_CARD_CAPTURE // pré-autorização + captura parcial no StopTransaction
  WALLET_TOPUP_PIX // recarga de saldo pré-pago (carteira) via Pix
}

enum PaymentIntentStatus {
  CREATED
  AUTHORIZED
  CAPTURE_PENDING
  CAPTURED
  CANCELLED
  DENIED
  VOIDED
  FAILED
  EXPIRED
  PENDING // Pix: PaymentIntent criado na Cielo, aguardando o motorista pagar o QR Code
  PAID // Pix: webhook (reconsultado) confirmou o pagamento — dispara crédito na carteira
}

// Ambiente do gateway Cielo sob o qual um PaymentMethod/PaymentIntent nasceu
// (F5.7, achado M4 do Órion). Token de cartão e intent são do ambiente que os
// criou: um token SANDBOX não cobra em PRODUCTION e um intent em trânsito seria
// reconsultado no host errado. É o AMBIENTE EFETIVO do gateway no instante da
// criação — a decisão de qual é o ambiente efetivo é do Vega, não do banco.
enum PaymentEnvironment {
  SANDBOX
  PRODUCTION
}

enum WalletEntryType {
  TOPUP_PIX
  TOPUP_REFUND
  CHARGE_DEBIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  REFUND
  DEBT_SETTLEMENT // quitação automática de Debt pelo crédito Pix (F5) — ver ux_wallet_entry_debt_settlement_once
}

enum DebtStatus {
  OPEN
  SETTLED
  WRITTEN_OFF
}

enum OcppDirection {
  INBOUND // carregador -> CSMS
  OUTBOUND // CSMS -> carregador
}

enum OcppMessageType {
  CALL
  CALL_RESULT
  CALL_ERROR
}

// Log de auditoria (ADMIN-only) — ver desenho completo da Nova em
// .claude/agent-memory/nova/decisoes-audit-log.md. AuditAction cobre
// mutação genérica (CREATE/UPDATE/DELETE), casos com semântica própria
// (REMOTE_COMMAND grava intenção, não resultado; WALLET_ADJUSTMENT é
// fail-closed dentro da transação do WalletEntry) e autenticação/extração.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  REMOTE_COMMAND
  WALLET_ADJUSTMENT
  LOGIN_SUCCESS
  LOGIN_FAILED
  EXPORT
  PAYMENT_CREDIT // crédito de Pix processado pelo worker (ator SYSTEM), F5
  PAYMENT_CONFIG_CHANGE // ADMIN altera PaymentGatewayConfig (segredos nunca em `changes`), F5
  OTHER // rota não mapeada ainda gera linha (nunca silêncio) — decisão da Nova
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

// Ator de uma linha de AuditLog. Enum SEPARADO de `Role` (decisão da Nova,
// F5, 2026-09-30): SYSTEM cobre eventos automáticos (ex.: crédito de Pix
// processado pelo worker, sem usuário logado) e NUNCA pode existir como
// role de um `User` de verdade — se SYSTEM entrasse em `Role`, nada
// impediria criar um User com essa role por engano. `actorRole` do
// AuditLog usa este enum; o snapshot do ator continua sem FK (ver
// comentário do model AuditLog).
enum AuditActorRole {
  ADMIN
  OPERATOR
  DRIVER
  SYSTEM
}

// ------------------------------------------------------------
// Multi-tenant: Operator / Site
// ------------------------------------------------------------

model Operator {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  cnpj      String?  @unique
  email     String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sites             Site[]
  users             User[]
  tariffs           Tariff[]
  tariffAssignments TariffAssignment[]

  // Tabelas quentes com operatorId desnormalizado (ver cabeçalho do arquivo).
  chargePoints     ChargePoint[]
  connectors       Connector[]
  chargingSessions ChargingSession[]
  meterSamples     MeterSample[]
  ocppMessages     OcppMessage[]
  paymentIntents   PaymentIntent[]
  debts            Debt[]
}

model Site {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  name         String
  addressLine  String
  city         String
  state        String
  postalCode   String
  country      String  @default("BR")
  latitude     Decimal @db.Decimal(9, 6)
  longitude    Decimal @db.Decimal(9, 6)
  timezone     String  @default("America/Sao_Paulo")
  openingHours Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  chargePoints      ChargePoint[]
  chargingSessions  ChargingSession[]
  tariffAssignments TariffAssignment[]

  @@index([operatorId])
}

// ------------------------------------------------------------
// Topologia OCPP: ChargePoint / Connector
// ------------------------------------------------------------

model ChargePoint {
  id     String @id @default(cuid())
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  siteId String

  // Desnormalizado a partir de site.operatorId — mantido por trigger
  // (ver migration.sql), não confiar em valor setado pela aplicação.
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  ocppIdentity        String  @unique // vem na URL do WebSocket (wss://.../ocpp/{ocppIdentity})
  vendor              String?
  model               String?
  serialNumber        String?
  firmwareVersion     String?
  basicAuthSecretHash String // hash — NUNCA o segredo em claro
  configSnapshot      Json?

  lastBootAt     DateTime? @db.Timestamptz(3)
  lastSeenAt     DateTime? @db.Timestamptz(3)
  // Instante em que o WebSocket deste carregador FECHOU (gateway OCPP,
  // `client.on('close')`). Só vale enquanto `disconnectedAt >= lastSeenAt` —
  // qualquer mensagem/conexão posterior atualiza `lastSeenAt` e o carregador
  // volta a "online" sozinho, sem ninguém precisar limpar esta coluna. Regra
  // única em `core/estacoes/disponibilidade.ts` (`isChargePointOnline`).
  // Existe para o "offline" aparecer NA HORA da queda (mapa/dashboard) em vez
  // de esperar o limiar de 5 min de `lastSeenAt`; NUNCA sobrescreve
  // `lastSeenAt` (que continua sendo o fato histórico "última mensagem") nem
  // `Connector.status` (OCPP: desconexão não implica status de conector).
  disconnectedAt DateTime? @db.Timestamptz(3)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  connectors        Connector[]
  chargingSessions  ChargingSession[]
  meterSamples      MeterSample[]
  ocppMessages      OcppMessage[]
  tariffAssignments TariffAssignment[]

  @@index([siteId])
  @@index([operatorId])
}

model Connector {
  id            String      @id @default(cuid())
  chargePointId String
  chargePoint   ChargePoint @relation(fields: [chargePointId], references: [id], onDelete: Restrict)

  // Desnormalizado a partir de chargePoint.operatorId — mantido por trigger.
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  // Número OCPP do conector dentro do charge point. connectorId = 0 no OCPP
  // significa "o carregador inteiro" — NUNCA cria linha aqui para ele
  // (reforçado por CHECK connector_id <> 0 na migration).
  connectorId      Int
  type             ConnectorType
  maxPowerKw       Decimal?        @db.Decimal(6, 2)
  status           ConnectorStatus @default(AVAILABLE)
  // statusUpdatedAt: relógio do CARREGADOR (data.timestamp do StatusNotification,
  // com fallback para now()) — serve à exibição/cobrança, NUNCA ao watchdog.
  statusUpdatedAt  DateTime?       @db.Timestamptz(3)
  // statusReceivedAt (F5.9, 2026-10-03): instante do SERVIDOR (now()) em que o
  // último StatusNotification foi registrado. É a única base do watchdog para
  // "há quanto tempo o conector está nesse status" (regra R2): relógio do
  // carregador pode estar errado/atrasado. NULL = nunca recebeu (o backfill da
  // migration 20261003130000 preencheu os existentes com now()).
  statusReceivedAt DateTime?       @db.Timestamptz(3)
  errorCode        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  chargingSessions  ChargingSession[]
  tariffAssignments TariffAssignment[]

  @@unique([chargePointId, connectorId])
  @@index([operatorId])
}

// ------------------------------------------------------------
// Identidade e autorização OCPP
// ------------------------------------------------------------

model User {
  id   String @id @default(cuid())
  role Role

  // Preenchido e obrigatório SÓ quando role = OPERATOR (CHECK constraint na
  // migration reforça isso). ADMIN e DRIVER ficam com operatorId nulo:
  // ADMIN atravessa todos os operadores; DRIVER é identidade única na rede
  // (B2C) e pode carregar em qualquer operador — não é "cliente" fechado
  // de um operador só. Ver PENDÊNCIAS no handoff se o dono quiser mudar isso.
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  name               String
  email              String    @unique
  phone              String?
  passwordHash       String?
  // Identificador ESTÁVEL do Google (claim `sub` do ID token) — não o e-mail, que
  // pode mudar do lado do Google. Só motoristas (DRIVER) entram por Google;
  // NULL para quem nunca usou. UNIQUE parcial natural: Postgres trata NULLs
  // como distintos, então vários usuários sem Google não colidem.
  googleSub          String?   @unique
  // CPF — dado pessoal (LGPD), coletado OPCIONALMENTE para pagamento via Pix
  // (F5). Nunca obrigatório no cadastro. 11 dígitos numéricos (CHECK na
  // migration) e índice único PARCIAL (WHERE cpf IS NOT NULL) — vários
  // usuários sem CPF não colidem entre si.
  cpf                String?   @db.VarChar(11)
  // Revogação de sessão (Órion A3/M1, 2026-09-19): JWT cujo `iat` (em segundos) seja
  // ANTERIOR a este instante é recusado por `authenticate`. Bump em: troca/definição de
  // senha, vínculo do Google (que também zera `passwordHash`) e rotação por script.
  // NULL = nunca revogado. Junto com `active`, é o que faz "desativar/trocar a senha" cortar
  // o token de 12h e o stream SSE (cache de ~30s no processo da API).
  sessionsValidAfter DateTime? @db.Timestamptz(3)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  authTokens       AuthToken[]
  chargingSessions ChargingSession[]
  wallet           Wallet?
  paymentMethods   PaymentMethod[]
  paymentIntents   PaymentIntent[]
  debts            Debt[]

  @@index([operatorId])
}

model AuthToken {
  id String @id @default(cuid())

  // OCPP 1.6 limita idTag a 20 caracteres — vale para RFID físico e para o
  // idTag virtual que a API gera por sessão iniciada pelo app.
  idTag  String        @unique @db.VarChar(20)
  type   AuthTokenType
  userId String?
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  status    AuthTokenStatus @default(ACCEPTED)
  expiresAt DateTime?       @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  chargingSessions ChargingSession[]

  // Pré-autorização de cartão vinculada a este idTag virtual (F5.4) — ver
  // PaymentIntent.authTokenId para a direção da FK e o porquê.
  paymentIntent PaymentIntent?

  @@index([userId])
}

// ------------------------------------------------------------
// Tarifação
// ------------------------------------------------------------

model Tariff {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  name  String
  model TariffModel

  // Preço unitário — Decimal(12,4), em reais (não centavos), nunca Float.
  // Ex.: 0.7912 = R$ 0,7912/kWh. Vega multiplica por kWh/minuto e só
  // arredonda para centavos no total gravado em ChargingSession.
  pricePerKwh    Decimal? @db.Decimal(12, 4)
  pricePerMinute Decimal? @db.Decimal(12, 4)

  // Estes já são valores fechados (não por-unidade) — centavos inteiros.
  sessionFeeCents Int?
  minChargeCents  Int?

  // Taxa de ociosidade: cobrada por minuto que o carro fica plugado sem
  // consumir energia depois que a carga terminou. Centavos inteiros.
  // idleGracePeriodSeconds é carência antes de começar a cobrar (default 0
  // = cobra desde o primeiro segundo de ociosidade).
  idleFeePerMinute       Int @default(0)
  idleGracePeriodSeconds Int @default(0)

  currency  String   @default("BRL") @db.Char(3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  windows          TariffWindow[]
  assignments      TariffAssignment[]
  chargingSessions ChargingSession[]

  @@index([operatorId])
}

// Janelas de ponta/fora-ponta — sobrepõem os preços base do Tariff quando
// a sessão cai dentro da janela (mais prioridade = ganha em caso de overlap,
// controlado por TariffAssignment.priority, não por TariffWindow).
model TariffWindow {
  id       String @id @default(cuid())
  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  label       String // ex.: "PONTA", "FORA_PONTA", "INTERMEDIARIA"
  daysOfWeek  Int[] // 0=domingo..6=sábado
  startMinute Int // minutos desde 00:00 (0-1439)
  endMinute   Int // minutos desde 00:00 (1-1440, exclusivo)

  // Overrides opcionais — nulo usa o preço base do Tariff.
  pricePerKwh      Decimal? @db.Decimal(12, 4)
  pricePerMinute   Decimal? @db.Decimal(12, 4)
  idleFeePerMinute Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([tariffId])
}

// Qual tarifa vale para qual conector/carregador/site/operador, com
// prioridade e validade. Exatamente uma das FKs de escopo deve bater com
// `scope` — reforçado por CHECK constraint na migration (não só por app).
model TariffAssignment {
  id       String @id @default(cuid())
  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  scope         TariffScope
  connectorId   String?
  connector     Connector?   @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  chargePointId String?
  chargePoint   ChargePoint? @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
  siteId        String?
  site          Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)

  priority  Int       @default(0)
  validFrom DateTime  @default(now()) @db.Timestamptz(3)
  validTo   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([operatorId])
  @@index([connectorId])
  @@index([chargePointId])
  @@index([siteId])
}

// ------------------------------------------------------------
// Sessão de recarga (o coração do domínio)
// ------------------------------------------------------------

model ChargingSession {
  id String @id @default(cuid())

  // INT32 atribuído por nós via SEQUENCE do Postgres — NUNCA UUID, NUNCA
  // contador por carregador. Colisão aqui = cobrar a sessão errada no
  // carregador errado. `autoincrement()` gera SERIAL/sequence real do
  // Postgres (não é um contador em memória da aplicação nem por charge
  // point) — é a mesma garantia que uma SEQUENCE nomeada à mão daria, só
  // que gerenciada pelo Prisma.
  ocppTransactionId Int @unique @default(autoincrement())

  // Desnormalizado (trigger) a partir de connector.operatorId — é a coluna
  // que o Vega usa para escopar toda query de sessão por operador, sem join.
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  // Desnormalizado (trigger) a partir de chargePoint.siteId — evita join
  // para telas "sessões do site X".
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  chargePointId String
  chargePoint   ChargePoint @relation(fields: [chargePointId], references: [id], onDelete: Restrict)

  // FK para Connector.id (PK interna, cuid) — não confundir com
  // Connector.connectorId (posição OCPP dentro do charge point).
  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Restrict)

  authTokenId String
  authToken   AuthToken @relation(fields: [authTokenId], references: [id], onDelete: Restrict)

  // Resolvido a partir do idTag no Authorize — uma sessão só existe se já
  // houver um pagador identificado (regra de negócio no Authorize, não aqui).
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status ChargingSessionStatus @default(STARTED)

  // Como esta sessão é cobrada — decidido no /sessions/start, antes de
  // existir qualquer PaymentIntent (ver enum ChargingSessionPaymentMode).
  paymentMode ChargingSessionPaymentMode @default(WALLET)

  meterStartWh      Int
  meterStopWh       Int?
  energyDeliveredWh Int? // = meterStopWh - meterStartWh, preenchido no StopTransaction

  startedAt DateTime @db.Timestamptz(3) // timestamp do StartTransaction — sempre do payload, nunca now()

  // --- Janela de ociosidade (idle fee) ---
  // chargingEndedAt: quando o carro parou de fato de puxar energia
  // (StatusNotification Finishing/SuspendedEV no conector, ou MeterValues
  // com potência zerada) enquanto a transação OCPP ainda está aberta.
  // stoppedAt: quando a transação efetivamente encerra (StopTransaction).
  // idleSeconds: intervalo entre os dois já descontada a carência da
  // tarifa (tariffSnapshot.idleGracePeriodSeconds) — calculado e congelado
  // no StopTransaction, nunca recalculado depois.
  chargingEndedAt DateTime?   @db.Timestamptz(3)
  stoppedAt       DateTime?   @db.Timestamptz(3)
  idleSeconds     Int?
  stopReason      StopReason?

  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  // OBRIGATÓRIO — congela a tarifa (preços, janelas aplicáveis, idle fee,
  // carência) vigente no início da sessão. Sessão antiga jamais recalcula
  // com a tarifa de hoje.
  tariffSnapshot Json

  energyCostCents          Int?
  timeCostCents            Int?
  idleFeeCents             Int?
  sessionFeeCents          Int?
  minChargeAdjustmentCents Int?
  totalCostCents           Int?

  // --- Painel "ao vivo" (retaguarda, 2026-09-16) ---
  // Preenchidas a cada MeterValues/StatusNotification enquanto a sessão está
  // em andamento — não são congeladas como o resto da sessão, são
  // sobrescritas a cada amostra. Nulas para sessões já encerradas antigas
  // (não fazemos backfill). Hoje (antes da Fase 4 real) só o
  // `seed-demo.ts` preenche, simulando o que o gateway OCPP vai manter
  // atualizado depois.
  lastSampleAt DateTime? @db.Timestamptz(3)
  lastPowerW   Int?
  lastSoc      Int? // 0-100, percentual de carga da bateria (OCPP SoC) — CHECK na migration

  // --- Sessão travada / watchdog (F5.9, 2026-10-03) ---
  // Desenho: .claude/agent-memory/nova/decisoes-f59-sessao-travada.md.
  // RELÓGIOS: lastActivityAt e os *RequestedAt/unconfirmedAt/lateStopReceivedAt
  // são relógio do SERVIDOR (now()); lastSampleAt/lateStopAt usam o relógio do
  // carregador (payload). O watchdog decide só com o relógio do servidor; a
  // cobrança só com o do carregador. Misturar os dois é bug.
  // lastActivityAt: última atividade OCPP observada para a sessão (qualquer
  // mensagem útil). NULL em linha antiga/STOPPED; o watchdog usa
  // COALESCE(lastActivityAt, startedAt) por segurança.
  lastActivityAt    DateTime? @db.Timestamptz(3)
  // lastMeterValuesAt (F5.9, 2026-10-03): instante do SERVIDOR (now()) do último
  // MeterValues DA TRANSAÇÃO. Distinto de lastActivityAt, que também se move com
  // StatusNotification etc.: a regra U1 ("reanimar" sessão não confirmada) só
  // pode considerar leitura de medidor de verdade. NULL = nenhum MeterValues
  // visto (o backfill da migration 20261003130000 copiou lastActivityAt nas
  // sessões abertas). Relógio do carregador fica em lastSampleAt.
  lastMeterValuesAt DateTime? @db.Timestamptz(3)

  // Pedido de parada (colunas ortogonais ao status — o StatusNotification é a
  // fonte de verdade do status físico e sobrescreveria um "STOPPING").
  stopRequestedAt DateTime?             @db.Timestamptz(3)
  stopRequestedBy SessionStopRequester?
  stopAttempts    Int                   @default(0) // CHECK >= 0 na migration

  // Entrada em STOP_UNCONFIRMED (CHECK: status STOP_UNCONFIRMED exige os dois).
  unconfirmedAt     DateTime?              @db.Timestamptz(3)
  unconfirmedReason StopUnconfirmedReason?

  // Custo PROVISÓRIO calculado no fechamento do servidor, para exibir ao
  // motorista/admin. Informativo: não debita, não captura. CHECK >= 0.
  provisionalCostCents Int?

  // Como a sessão foi fechada e com que prova de medidor.
  closureSource   SessionClosureSource?
  meterStopSource MeterStopSource?

  // StopTransaction que chegou DEPOIS de a sessão já estar STOPPED (carregador
  // enfileira offline e manda após o Boot). STOPPED é terminal: só REGISTRA.
  // lateStopMeterWh no mesmo tipo de meterStopWh (Int). unbilledCostCents é a
  // diferença de custo não cobrada — apenas informativo (igual ao REFUND);
  // cobrar a diferença é decisão do dono. CHECK >= 0.
  lateStopMeterWh    Int?
  lateStopAt         DateTime? @db.Timestamptz(3) // timestamp do payload do carregador
  lateStopReceivedAt DateTime? @db.Timestamptz(3) // now() do servidor ao receber
  unbilledCostCents  Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  meterSamples   MeterSample[]
  paymentIntents PaymentIntent[]
  debts          Debt[]
  // Índice parcial do watchdog (F5.9) NÃO aparece aqui — Prisma não expressa
  // WHERE em índice não-único. Vive só na migration 20261003120100:
  //   ix_charging_session_watchdog (status, "lastActivityAt")
  //   WHERE status IN (STARTED, CHARGING, FINISHING, FAULTED, STOP_UNCONFIRMED)
  // `migrate diff --from-url` contra o banco migrado NÃO o acusa (verificado: só
  // aparece o ux_ocpp_message_dedupe de sempre).

  @@index([operatorId, startedAt])
  @@index([siteId, startedAt])
  @@index([userId, startedAt])
  @@index([chargePointId, startedAt])
  @@index([connectorId])
  // Índices de relatório (retaguarda, 2026-09-16) — as 7 rotas de agregação
  // do Vega sempre filtram por status junto com o período; os índices acima
  // (sem status) continuam servindo consultas "todas as sessões do
  // operador/site no período" (ex.: contagem de tentativas/erros). Ver
  // memória do Cronos: reavaliar depois de medir se algum dos dois vira
  // redundante.
  @@index([operatorId, status, startedAt])
  @@index([siteId, status, startedAt])
}

// ------------------------------------------------------------
// Logs de alto volume — PARTICIONADOS POR MÊS (ver migration.sql)
// ------------------------------------------------------------

// Medições do medidor (OCPP MeterValues). ~500 mil linhas/dia na escala
// alvo. PK composta (id, ts) porque Postgres exige que a chave de partição
// esteja em qualquer PK/UNIQUE de tabela particionada.
model MeterSample {
  id String @default(cuid())

  sessionId String?
  session   ChargingSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  chargePointId String
  chargePoint   ChargePoint @relation(fields: [chargePointId], references: [id], onDelete: Restrict)

  // Desnormalizado a partir de chargePoint.operatorId — mantido por trigger.
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  ts        DateTime @db.Timestamptz(3) // timestamp do payload (MeterValues.req) — chave de partição, nunca now()
  measurand String // "Energy.Active.Import.Register", "Power.Active.Import", "SoC", ...
  value     Decimal  @db.Decimal(14, 4)
  unit      String?
  context   String? // Sample.Periodic, Transaction.Begin, Transaction.End, ...
  phase     String?
  location  String?
  raw       Json? // sampledValue original — prova em disputa de kWh

  @@id([id, ts])
  @@index([sessionId, ts])
  @@index([chargePointId, ts])
  @@index([operatorId, ts])
}

// Log bruto do protocolo OCPP — obrigatório neste domínio para disputa de
// kWh (fonte de verdade além do MeterSample já processado). Particionado
// por mês. PK composta (id, occurredAt) pela mesma razão do MeterSample.
model OcppMessage {
  id String @default(cuid())

  chargePointId String
  chargePoint   ChargePoint @relation(fields: [chargePointId], references: [id], onDelete: Restrict)

  // Desnormalizado a partir de chargePoint.operatorId — mantido por trigger.
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  direction   OcppDirection
  messageType OcppMessageType

  // Id de correlação do envelope OCPP-J — junto com chargePointId é a chave
  // de idempotência do handler (regra da Nova: nunca reprocessar a mesma
  // (chargePointId, ocppMessageId) duas vezes).
  ocppMessageId String
  action        String? // nome da action OCPP no CALL; nulo em CALLRESULT/CALLERROR

  payload Json // envelope bruto — auditoria/disputa

  occurredAt DateTime @db.Timestamptz(3) // tempo do evento (do payload quando disponível) — chave de partição, nunca now()
  receivedAt DateTime @default(now()) @db.Timestamptz(3) // quando o gateway processou — pode ficar bem depois do occurredAt (carregador offline reconectando)

  @@id([id, occurredAt])
  @@index([chargePointId, occurredAt])
  @@index([operatorId, occurredAt])
}

// ------------------------------------------------------------
// Pagamento — cartão (Cielo) e Pix (carteira pré-paga)
// ------------------------------------------------------------

model PaymentMethod {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type PaymentMethodType @default(CREDIT_CARD)

  // Token da Cielo — NUNCA PAN, NUNCA CVV. Nome do campo deixa explícito
  // que o valor é sempre cifrado (AES-256-GCM) — nunca texto puro. Cifra e
  // decifra são do Vega (fora deste escopo); a chave fica só em env
  // (PAYMENT_SECRETS_KEY), nunca no banco — mesmo padrão de
  // PaymentGatewayConfig.*Ciphertext.
  cieloCardTokenCiphertext String
  brand                    String?
  last4                    String?
  holderName               String?
  expiryMonth              Int?
  expiryYear               Int?

  // Ambiente Cielo em que o cartão foi tokenizado (F5.7). O token só vale
  // nesse ambiente — listar/cobrar filtra por este campo. DEFAULT SANDBOX:
  // toda linha pré-existente nasceu sob sandbox ou sob o simulador (nunca
  // houve dinheiro real), então SANDBOX é o rótulo verdadeiro do legado.
  // Sem índice próprio: ver migration 20261002120000_payment_environment.
  environment PaymentEnvironment @default(SANDBOX)

  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  paymentIntents PaymentIntent[]

  @@index([userId])
}

model PaymentIntent {
  id String @id @default(cuid())

  // Desnormalizado (trigger) a partir de chargingSession.operatorId — nulo
  // em recarga de carteira (WALLET_TOPUP_PIX), que não pertence a um
  // operador específico (a carteira é da rede, não de um operador).
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  purpose  PaymentIntentPurpose
  provider PaymentProvider

  // Ambiente Cielo sob o qual o intent foi criado (F5.7) — define em qual host
  // (sandbox/produção) ele deve ser reconsultado/capturado/cancelado, e
  // bloqueia a troca de ambiente do gateway enquanto houver intent "vivo"
  // nele. DEFAULT SANDBOX pelo mesmo motivo de PaymentMethod.environment
  // (legado nunca processou dinheiro real). Sem índice próprio: ver migration
  // 20261002120000_payment_environment.
  environment PaymentEnvironment @default(SANDBOX)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  chargingSessionId String?
  chargingSession   ChargingSession? @relation(fields: [chargingSessionId], references: [id], onDelete: Restrict)

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)

  // Vínculo com a pré-autorização de cartão (F5.4) — preenchido SÓ quando
  // purpose='SESSION_CARD_CAPTURE' (Pix/WALLET_TOPUP_PIX nunca usa, reforçado
  // por payment_intent_purpose_consistency). @unique porque cada idTag
  // virtual autoriza no máximo um PaymentIntent. É o vínculo que o
  // StartTransaction usa para achar a pré-autorização AUTHORIZED a partir do
  // idTag que chegou no handshake OCPP: AuthToken.idTag -> AuthToken.id ->
  // PaymentIntent.authTokenId. Nullable mesmo dentro de SESSION_CARD_CAPTURE
  // porque sessões demo/históricas (seed-demo.ts) são inseridas já
  // vinculadas via chargingSessionId, sem nunca ter passado pelo fluxo real
  // de pré-auth com AuthToken.
  authTokenId String?    @unique
  authToken   AuthToken? @relation(fields: [authTokenId], references: [id], onDelete: Restrict)

  cieloPaymentId String?             @unique
  status         PaymentIntentStatus @default(CREATED)

  // Cielo ReturnCode — Status sozinho NÃO prova aprovação (ex.: Status=1
  // Authorized não é pago). Ver checagem obrigatória no handoff.
  returnCode String?

  amountRequestedCents  Int
  amountAuthorizedCents Int?
  // Valor-ALVO da captura, calculado e gravado pelo finalizarSessao ao
  // entrar em CAPTURE_PENDING: min(total da sessão, amountAuthorizedCents).
  // DISTINTO de amountCapturedCents (abaixo) — não confundir os dois:
  // captureAmountCents é o que MANDAMOS cobrar (nosso alvo, gravado antes de
  // chamar a Cielo); amountCapturedCents é o que a Cielo de fato CONFIRMOU
  // ter capturado (só preenchido depois do sucesso do PUT /capture). Os dois
  // convivem — captureAmountCents não é substituído por amountCapturedCents,
  // fica como registro do que foi pedido mesmo se a captura falhar/retentar.
  captureAmountCents    Int?
  amountCapturedCents   Int?
  // Estorno/chargeback de cartão (F5, ChangeType 7/25 do webhook Cielo): o
  // status NUNCA muda para "reembolsado" (ficaria CAPTURED para sempre) —
  // só informativo, mesmo espírito do REFUND da carteira. Trocar o status
  // tiraria o valor do `cardCaptured` na conciliação e quebraria a
  // identidade `accounted = cardCaptured + ... `. Ver decisão §4 da Nova.
  amountRefundedCents   Int       @default(0)
  chargebackAt          DateTime? @db.Timestamptz(3)

  // Motivo de falha/negação — para a tela do motorista e para o varredor
  // decidir se vale retentar consulta. Nunca dado sensível de cartão.
  failureReason String?

  pixQrCode    String?
  pixExpiresAt DateTime? @db.Timestamptz(3)

  authorizedAt DateTime? @db.Timestamptz(3)
  capturedAt   DateTime? @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  debts         Debt[]
  webhookEvents WebhookEvent[]

  @@index([operatorId])
  @@index([userId])
  @@index([status])
  @@index([chargingSessionId])
  // Índices de relatório (retaguarda, 2026-09-16) — /reports/payments e
  // /reports/revenue agregam por operador/propósito+status dentro de um
  // período de captura.
  @@index([operatorId, status, capturedAt])
  @@index([purpose, status, capturedAt])
  // Varredor de conciliação (F5) — reconsulta intents "vivos" há mais tempo
  // (CREATED/AUTHORIZED/CAPTURE_PENDING) ordenando por quando pararam de
  // mudar, sem precisar varrer a tabela inteira por status.
  @@index([status, updatedAt])
}

// Carteira pré-paga (Pix). Saldo = SOMA das entradas — nunca
// `UPDATE saldo = saldo - x`. Razão é per-usuário (rede toda), não por
// operador, porque o motorista roda por qualquer operador (B2C).
model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  entries        WalletEntry[]
  paymentIntents PaymentIntent[]
}

// Razão append-only — trigger na migration BLOQUEIA UPDATE/DELETE nesta
// tabela (integridade por desenho, não por confiança no código da app).
// Sem updatedAt de propósito: uma entrada nunca é alterada.
model WalletEntry {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type        WalletEntryType
  amountCents Int // assinado: crédito > 0, débito < 0

  // Snapshot do saldo logo após esta entrada — só para leitura rápida do
  // saldo atual sem somar o histórico inteiro; nunca recalculado depois.
  balanceAfterCents Int

  referenceType String? // "PAYMENT_INTENT" | "CHARGING_SESSION" | "MANUAL" | ...
  referenceId   String?
  description   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  createdBy String? // userId do admin, se for ajuste manual

  @@index([walletId, createdAt])
  // Relatório de financeiro (retaguarda, 2026-09-16) — soma débitos de
  // carteira por tipo (CHARGE_DEBIT) num período, sem depender de walletId.
  @@index([type, createdAt])
}

// Captura que falhou vira dívida e bloqueia NOVA sessão (checagem no
// Authorize/StartTransaction, não aqui). Bloqueio é por usuário na rede
// inteira, não só no operador de origem — por isso operatorId aqui é só
// informativo/relatório, não é campo de escopo de acesso.
model Debt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  chargingSessionId String?
  chargingSession   ChargingSession? @relation(fields: [chargingSessionId], references: [id], onDelete: SetNull)

  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  amountCents Int
  status      DebtStatus @default(OPEN)
  reason      String?

  settledAt              DateTime? @db.Timestamptz(3)
  settledByWalletEntryId String? // referência informativa (sem FK) para a WalletEntry que quitou a dívida

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId, status])
  @@index([operatorId])
  // Relatório de financeiro (retaguarda, 2026-09-16) — dívida aberta por
  // operador num período entra na identidade de conciliação (faturamento =
  // capturas + débitos de carteira + dívida aberta).
  @@index([operatorId, status, createdAt])
}

// Caixa de entrada do webhook da Cielo — NUNCA fonte de verdade (a Cielo não
// assina o corpo, só até 3 headers estáticos como segredo compartilhado).
// O worker grava aqui, responde 200 e RECONSULTA `apiquery` com nossa
// credencial antes de agir (ver decisão §3 da Nova). Por isso o dedupe de
// (provider, externalId, changeType) NÃO pode ser UNIQUE de escrita: um Pix
// pendente→pago é a MESMA (provider, externalId) com changeType diferente
// (mais de uma mudança de status legítima para o mesmo PaymentId) — um
// UNIQUE aqui descartaria a 2ª notificação. A idempotência real fica no
// EFEITO (ux_wallet_entry_topup_once / ux_wallet_entry_debt_settlement_once),
// não no evento; este índice é só para consulta/depuração.
model WebhookEvent {
  id String @id @default(cuid())

  provider   String // "CIELO"
  externalId String // Cielo PaymentId
  changeType Int // 1 status, 5 cancelamento negado, 7 chargeback, 25 estorno parcial

  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  payload         Json
  receivedAt      DateTime  @default(now()) @db.Timestamptz(3)
  processedAt     DateTime? @db.Timestamptz(3)
  processingError String?
  // Quantas vezes o worker tentou reconsultar/processar este evento —
  // observabilidade e critério de "desistir e deixar para o varredor de
  // PaymentIntent" em vez de reprocessar para sempre um evento quebrado.
  attempts        Int       @default(0)

  @@index([provider, externalId, changeType])
  @@index([paymentIntentId])
}

// Config ÚNICA (singleton) do gateway de pagamento — é a NOSSA conta
// comercial na Cielo (plataforma inteira, não por operador — a porta é do
// gateway, não de carteira, ver decisão §1 da Nova). Singleton reforçado
// por CHECK (id = 1) na migration, não só por convenção da aplicação.
//
// SEGREDOS: os três campos *Ciphertext guardam o texto CIFRADO (AES-256-GCM,
// base64 de iv+authTag+ciphertext) — nunca o segredo em claro. A CHAVE de
// cifragem (env `PAYMENT_SECRETS_KEY`) vive SÓ em variável de ambiente,
// NUNCA no banco — se o banco vazar sozinho, os segredos continuam
// ilegíveis. Rotação de chave é operação de aplicação (decifra com a chave
// antiga, recifra com a nova), fora do escopo desta migration.
model PaymentGatewayConfig {
  id Int @id @default(1)

  environment String // "sandbox" | "production"

  merchantId            String?
  merchantKeyCiphertext String? // cifrado — ver comentário do model

  sopClientId               String?
  sopClientSecretCiphertext String? // cifrado — ver comentário do model

  // Segredo compartilhado (até 3 headers estáticos) que a Cielo ecoa no Post
  // de Notificação — não é assinatura, é o que valida "isto veio de quem
  // conhece o segredo combinado no Site Cielo". Cifrado.
  webhookHeaderSecretCiphertext String?

  cardEnabled Boolean @default(false)
  pixEnabled  Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ------------------------------------------------------------
// Auditoria (ADMIN-only)
// ------------------------------------------------------------
//
// Desenho completo: .claude/agent-memory/nova/decisoes-audit-log.md
// (Nova, 17/09/2026). Decisões que este model já reflete — não reabrir sem
// motivo novo:
// - SEM particionamento (volume 3 ordens de magnitude menor que MeterSample/
//   OcppMessage; gatilho pra reconsiderar: >20M linhas ou p95 >800ms).
// - Append-only por trigger no mesmo padrão de WalletEntry, MAS com DELETE
//   liberado para linhas mais antigas que o piso de retenção (24 meses) —
//   ver migration.sql. UPDATE é bloqueado sempre.
// - `changes` é DIFF por allowlist de campos por entidade, nunca req.body
//   cru e nunca segredo (password/hash/token) — a allowlist vive no código
//   do Vega, não no banco.
// - Campos de ator (actorUserId/actorRole/actorEmail/actorName/
//   actorOperatorId) e targetOperatorId são SNAPSHOT histórico, sem FK.
//   Motivo: a linha precisa sobreviver a um User apagado/anonimizado (LGPD)
//   ou a mudança de role/operador depois do fato — uma FK obrigaria manter
//   o registro pai vivo para sempre, o que contradiz o propósito do log.
// - F5 (2026-09-30, crédito de Pix processado pelo worker, sem ator
//   humano): `actorRole` usa o enum SEPARADO `AuditActorRole` (inclui
//   SYSTEM), não `Role` — nunca deve existir um `User` com role SYSTEM.
//   `method`/`path`/`httpStatus` viram anuláveis, mas SÓ para
//   `actorRole = 'SYSTEM'` — reforçado por CHECK na migration
//   (`audit_log_http_fields_required_unless_system`), não só por convenção
//   da aplicação. `actorUserId`/`actorEmail`/`actorName` continuam
//   obrigatórios mesmo para SYSTEM (worker usa um id/e-mail sentinela fixo,
//   ex. "system@innoelektron", para o ator nunca aparecer "vazio" no log).
model AuditLog {
  id String @id @default(cuid())

  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  // Ator — snapshot no momento do evento, sem FK (ver comentário acima).
  // userId/role/email/name são NOT NULL de propósito (Nova, §1.1): todo
  // caminho que gera uma linha de auditoria já tem um ator conhecido — um
  // humano autenticado, ou o sentinela SYSTEM para eventos automáticos
  // (LOGIN_FAILED só loga quando o e-mail já é de uma conta existente —
  // nunca tentativa de e-mail desconhecido). Só operatorId é opcional
  // (ADMIN/SYSTEM não têm operador próprio).
  actorUserId     String
  actorRole       AuditActorRole
  actorEmail      String
  actorName       String
  actorOperatorId String?

  action       AuditAction
  actionDetail String? // texto livre curto, ex.: "ajuste manual de saldo"
  outcome      AuditOutcome
  // NULL só quando actorRole = 'SYSTEM' (evento automático, sem requisição
  // HTTP por trás) — CHECK na migration reforça isso.
  httpStatus   Int?

  entityType String? // ex.: "Tariff", "ChargePoint", "Wallet"
  entityId   String?

  // Operador afetado pela ação — também snapshot, sem FK (mesmo motivo).
  targetOperatorId String?

  // NULL só quando actorRole = 'SYSTEM' — mesmo CHECK do httpStatus acima.
  method String? // verbo HTTP
  path   String? // rota, ex.: "/api/admin/drivers/:id/wallet"

  ipAddress String?
  userAgent String?

  requestId     String? // correlação com log de aplicação/proxy
  correlationId String? // correlação com OcppMessage, quando action=REMOTE_COMMAND

  // DIFF apenas dos campos alterados (allowlist por entidade) — NUNCA
  // snapshot completo, NUNCA segredo. Ver comentário do model.
  changes Json?
  // Índice PARCIAL (occurredAt) WHERE outcome <> 'SUCCESS' — Prisma não tem
  // DSL para WHERE em índice normal (só em @@unique parcial via migration
  // hand-escrita, mesma convenção dos ux_* já existentes neste projeto).
  // Criado só no migration.sql, ver ix_audit_log_non_success.

  @@index([occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
  @@index([targetOperatorId, occurredAt])
}
