# Template processado pelo entrypoint da imagem nginx (envsubst):
# ${API_UPSTREAM} vem do ambiente do container (default no frontend/Dockerfile).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # ---- Sessão de recarga ao vivo (SSE) — buffering OFF, timeout longo ----
    # /api/sessions/:id/stream manda eventos incrementais; nginx com buffer
    # ligado (padrão) segura tudo até fechar a conexão, e o front nunca vê
    # nada em tempo real. Location mais específica vence sobre /api/ abaixo.
    location ~ ^/api/sessions/[^/]+/stream$ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        chunked_transfer_encoding off;
    }

    # ---- API na MESMA ORIGEM ----
    # O frontend chama /api/... no próprio domínio e o nginx repassa ao
    # container da API pela rede interna do EasyPanel. Sem DNS público de
    # subdomínio, sem CORS. `^~` impede que o regex de estáticos capture
    # essas rotas. resolver = DNS interno do Docker, resolvido a cada
    # requisição (nginx sobe mesmo se a API ainda estiver reiniciando).
    location ^~ /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
        proxy_read_timeout 30s;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /health {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
