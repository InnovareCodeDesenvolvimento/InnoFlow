# Template processado pelo entrypoint da imagem nginx (envsubst):
# ${API_UPSTREAM} vem do ambiente do container (default no frontend/Dockerfile).

# ---- Declarações de contexto `http` (este arquivo é incluído DENTRO de `http {}`) ----
# Webhook da Cielo (F5.8, portão final da F5 — Órion): o `pathToken` é um SEGREDO e vai no CAMINHO
# (`/api/webhooks/cielo/<token>`), então o access log padrão do nginx o gravaria em claro. Usado só pela
# location do webhook, mais abaixo.
#
# Máscara: `$request_uri` bruto -> `/api/webhooks/cielo/***` (query descartada). Se o regex NÃO casar (URI com
# `//`, `%2F` etc. — o nginx normaliza para escolher a location, mas `$request_uri` fica cru), cai no `default`
# `-`: perde-se o caminho no log, nunca vaza o token.
map $request_uri $webhook_uri_mascarado {
    default                      "-";
    ~^(/api/webhooks/cielo/)     "$1***";
}

# Mesmo log do access log padrão + o que importa para operar um webhook sem o token: status, tempo e o status
# do upstream (o erro de fundo vai para o `error_log`, que na location abaixo é silenciado — ver lá).
log_format webhook_mascarado '$remote_addr xff="$http_x_forwarded_for" [$time_local] '
                             '"$request_method $webhook_uri_mascarado $server_protocol" $status $body_bytes_sent '
                             '"$http_user_agent" rt=$request_time urt=$upstream_response_time us=$upstream_status';

# IP "de verdade" para o limite do webhook. Atrás do edge do EasyPanel `$remote_addr` é SEMPRE o IP do proxy
# (medido em produção, ver docs/DEPLOY-EASYPANEL.md — `TRUST_PROXY_HOPS=2`), então limitar por `$remote_addr`
# viraria UM balde global. O ÚLTIMO item do `X-Forwarded-For` que chega aqui é o que o edge (confiável) acrescentou
# = o cliente real; itens anteriores podem ser forjados pelo próprio cliente, por isso o último. Sem XFF (acesso
# direto à porta 80), cai no `$remote_addr`. Se a topologia mudar (proxy a mais/a menos), o pior caso é o limite
# do nginx ficar frouxo/global — o limite do backend (60/min/IP) continua valendo por baixo.
map $http_x_forwarded_for $webhook_cliente_ip {
    default                      $remote_addr;
    ~(?<ultimo>[^,\s]+)\s*$      $ultimo;
}

# 10 req/s por IP (= 600/min), BEM acima dos 60/min do backend (`webhookCieloRateLimit`): aqui é só proteção
# contra inundação antes de chegar no Node; o limite "de negócio" continua sendo o do backend.
limit_req_zone $webhook_cliente_ip zone=webhook_cielo:1m rate=10r/s;

server {
    listen 80;
    server_name _;

    # Não anuncia a versão do nginx no header `Server` nem nas páginas de erro.
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # ---- Headers de segurança (achado real: scanner externo deu nota F,
    # 17/09/2026 — nenhum destes existia) -----------------------------------
    # Nenhum destes depende do domínio final: são por natureza (X-Frame-
    # Options/nosniff/Referrer-Policy/Permissions-Policy) ou HSTS é por
    # hostname (se um dia trocar de domínio, o HSTS do domínio antigo
    # simplesmente não se aplica ao novo — sem risco de "travar" nada).
    # `always` força o header também em respostas de erro (404/5xx).
    #
    # nginx NÃO herda `add_header` do bloco pai numa location que já define
    # o seu próprio `add_header` (gotcha clássico) — por isso estas linhas
    # são repetidas em CADA location abaixo que já tinha `add_header`
    # próprio (estáticos/health//), em vez de confiar em herança parcial.
    #
    # MAPA DE ELETROPOSTOS (19/09/2026): img-src libera SÓ `tile.openstreetmap.org`
    # (host exato dos tiles, sem subdomínios — conferido em request real pelo
    # E2E da Lyra). O padrão da lib de mapa é o OSM (o Carto exige chave); se um
    # dia o provedor mudar (`VITE_MAP_TILE_URL`), o host novo TEM que entrar
    # aqui nas 5 cópias, senão o mapa aparece cinza. OSM só serve tráfego leve.
    #
    # LOGIN COM GOOGLE (19/09/2026): script-src/style-src/connect-src/frame-src
    # liberam SÓ os caminhos oficiais do Google Identity Services
    # (accounts.google.com/gsi/*, lista da doc do Google) e img-src o domínio
    # de avatar (googleusercontent.com) — nada de accounts.google.com inteiro.
    # Sem isso o botão "Continuar com o Google" nunca carrega (o CSP bloqueia o
    # script). Mantenha as 5 cópias da linha CSP em sincronia (gotcha de herança
    # do add_header, ver acima).
    #
    # CSP: script-src sem 'unsafe-inline' (é a proteção real contra XSS);
    # style-src precisa de 'unsafe-inline' (componentes React com `style=`
    # inline) + fonts.googleapis.com (ver index.html, Inter via <link>);
    # font-src libera fonts.gstatic.com (onde o arquivo da fonte realmente
    # baixa). connect-src só 'self' — API e SSE são mesma origem, sem CORS
    # externo. Permissions-Policy: geolocation=(self) ("eletropostos perto de
    # mim", 19/09/2026 — só a própria origem pode pedir, nunca iframe de
    # terceiro); camera/microphone continuam desligados (o scanner de QR é a
    # câmera NATIVA do celular, fora do navegador — se um dia existir scanner
    # DENTRO do app, câmera precisa ser liberada aqui). Não foi possível testar contra nginx real
    # neste ambiente (sem Docker) — conferir o console do navegador por
    # violação de CSP depois do primeiro deploy.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com https://tile.openstreetmap.org; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;

    # ---- CADASTRO DE CARTÃO (F5.3, 30/09/2026) — documento ISOLADO --------
    # SAQ A-EP (ver `.claude/agent-memory/nova/decisoes-f5-pagamento-cielo.md`
    # §2 e `frontend/src/pagamento-cartao/`): CSP PRÓPRIA e MUITO mais rígida
    # que a do resto do site — nenhuma das exceções acima (Google Fonts/GIS,
    # tiles OSM) se aplica aqui, porque esta página não deveria precisar de
    # NENHUMA delas.
    #
    # `script-src`/`connect-src`/`frame-src` ainda são só 'self' porque a URL
    # real do script de tokenização (Silent Order Post) da Cielo NÃO foi
    # confirmada ainda (3 perguntas em aberto pro comercial, ver
    # PROGRESSO.md §F5) — o app usa um mock local enquanto isso
    # (`pagamento-cartao/sopClient.ts`), que nunca bate em rede nenhuma.
    # QUANDO a Cielo confirmar: adicionar SÓ esse host exato em `script-src`
    # (o script em si) E em `connect-src`/`frame-src` se o SDK abrir XHR ou
    # iframe próprio para o POST de tokenização — NUNCA um wildcard amplo tipo
    # `*.cielo.com.br`. Sem isso o SDK real não carrega nem consegue enviar o
    # cartão — e é exatamente esse bloqueio que garante que, até lá, nenhum
    # dado de cartão pode vazar para fora desta origem por engano.
    #
    # `frame-ancestors 'none'` + `X-Frame-Options: DENY`: esta página NUNCA
    # deve ser embutida em iframe, nem pelo nosso próprio site — é aba/janela
    # própria de propósito (ver `useAddCardFlow.ts`: um iframe mesma-origem
    # continuaria acessível via DOM/JS pela SPA, o que anularia o ponto da
    # isolação). `Cache-Control: no-store`: a página carrega um formulário de
    # cartão e um `accessToken` de sessão — nunca pode ficar em cache de
    # disco/proxy. `Referrer-Policy: no-referrer`: nem a própria URL desta
    # página (que não leva segredo nenhum, mas por princípio) vaza para
    # quem quer que seja referenciado a partir daqui.
    location = /pagamento-cartao.html {
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'" always;
        try_files $uri =404;
    }

    # ---- Qualquer stream SSE sob /api/ — buffering OFF, timeout longo ----
    # Genérico por DESENHO: casa qualquer endpoint que termine em "/events"
    # dentro de /api/ (ex.: /api/admin/events, /api/me/events, e o que vier
    # depois), em vez de travar em um nome de rota específico que pode nunca
    # existir de verdade (era o bug anterior: regex só casava
    # /api/sessions/:id/stream, rota que o backend nunca implementou).
    #
    # ATENÇÃO ao mexer aqui: esta location só é alcançada porque o bloco
    # /api/ abaixo NÃO tem o modificador `^~`. Em nginx, `^~` no prefixo mais
    # específico faz o motor pular TODA checagem de regex — ou seja, com
    # `^~ /api/` (como era antes), nenhuma location `~ regex` sob /api/
    # jamais seria avaliada, mesmo que a rota existisse no backend. Não
    # reintroduza `^~` em /api/ sem entender essa consequência.
    location ~ ^/api/.*/events$ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # Connection vazia + http/1.1: permite keepalive de verdade com o
        # upstream em vez de fechar a conexão a cada chunk, importante pra
        # uma conexão SSE que fica aberta minutos/horas.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        # Heartbeat do servidor (`:ping`) sai a cada ~20-25s; 600s dá margem
        # folgada pra nunca ser cortado por inatividade de rede instável.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        chunked_transfer_encoding off;
        # Segunda camada de defesa: se algum dia isto passar por OUTRO proxy
        # (CDN/EasyPanel) que também respeite este header, ele desliga
        # buffering ali também, mesmo sem replicar esta location inteira.
        add_header X-Accel-Buffering "no" always;
        # Repetido aqui por causa do gotcha de herança do `add_header`
        # explicado no topo do arquivo — esta location já define o seu
        # próprio `add_header` (acima), então NÃO herda os do server.
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com https://tile.openstreetmap.org; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
    }

    # ---- Webhook da Cielo (F5.8) — token no CAMINHO, nunca no log ---------
    # `POST /api/webhooks/cielo/<pathToken>` (público, sem JWT; segredo = pathToken + header estático, ver F5.2).
    #
    # `^~` AQUI é de propósito e NÃO contradiz o aviso sobre `/api/` mais abaixo: `^~` só desliga a checagem de
    # regex para URLs cujo prefixo mais longo é ESTA location (`/api/webhooks/cielo/...`). O webhook não é SSE, e
    # sem o `^~` um token terminado em `.js`/`.css`/`/events` cairia no regex de estáticos/SSE em vez daqui. O
    # resto de `/api/` continua sem `^~` e continua alcançando a location regex de SSE.
    #
    # - Log: SEM o caminho (formato `webhook_mascarado`, acima) — o token não fica no disco/stdout do nginx.
    # - `error_log ... crit`: o nginx grava a linha de requisição CRUA ("request: POST /api/webhooks/cielo/<token>")
    #   em toda linha de erro (upstream caiu, timeout, body grande, limit_req) e NÃO há como mascarar isso. Nesta
    #   location só erros críticos vão ao error_log; o diagnóstico (502/504/413/429) fica no access log mascarado
    #   (`us=`/`urt=`). Trade-off consciente: se precisar depurar um webhook, suba o nível TEMPORARIAMENTE e lembre
    #   que o token vai junto.
    # - `client_max_body_size 64k`: a notificação da Cielo é um JSON minúsculo (ids), 10m do `/api/` é folga demais
    #   para uma rota pública sem autenticação.
    # - `limit_req`: ver o comentário da zona. `burst=100 nodelay` absorve rajada de retry da Cielo sem atrasar;
    #   estourou, responde 429 (a Cielo reenvia).
    # - Proxy: IGUAL ao `/api/` (mesmos headers e timeout). Sem `add_header` nesta location, então os headers de
    #   segurança do `server` são herdados normalmente — NÃO precisa de 6ª cópia.
    location ^~ /api/webhooks/cielo/ {
        access_log /var/log/nginx/access.log webhook_mascarado;
        error_log /var/log/nginx/error.log crit;

        client_max_body_size 64k;
        limit_req zone=webhook_cielo burst=100 nodelay;
        limit_req_status 429;

        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # ---- API na MESMA ORIGEM ----
    # O frontend chama /api/... no próprio domínio e o nginx repassa ao
    # container da API pela rede interna do EasyPanel. Sem DNS público de
    # subdomínio, sem CORS. SEM `^~` de propósito: precisamos que a location
    # de SSE acima (regex) seja avaliada para paths sob /api/ — ver o
    # comentário lá em cima. Confirmado que nenhuma rota do backend serve
    # paths terminados nas extensões estáticas abaixo, então o regex de
    # assets não tem como interceptar nada de /api/ por engano. resolver =
    # DNS interno do Docker, resolvido a cada requisição (nginx sobe mesmo
    # se a API ainda estiver reiniciando).
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
        proxy_read_timeout 30s;
    }

    # Mesmo gotcha de herança do `add_header` (ver comentário no topo do
    # arquivo) — as 3 locations abaixo já tinham `add_header` próprio antes
    # desta mudança, então os headers de segurança do server NÃO chegariam
    # aqui sem repetir.
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com https://tile.openstreetmap.org; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
        try_files $uri =404;
    }

    location /health {
        return 200 "ok";
        add_header Content-Type text/plain;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com https://tile.openstreetmap.org; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com https://tile.openstreetmap.org; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
    }
}
